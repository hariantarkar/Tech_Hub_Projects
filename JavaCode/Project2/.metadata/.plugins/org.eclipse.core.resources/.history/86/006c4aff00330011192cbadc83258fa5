<%@ page language="java" contentType="text/html; charset=ISO-8859-1"%>

<!DOCTYPE html>
<html>
<head>
<title>AI Chatbot</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins&display=swap" rel="stylesheet">

<style>
body{
font-family:Poppins;
background:#0f172a;
color:white;
display:flex;
justify-content:center;
align-items:center;
height:100vh;
}

.chat-box{
width:400px;
background:#111;
border-radius:15px;
overflow:hidden;
box-shadow:0 0 20px #00f5ff;
}

.header{
background:#00f5ff;
color:black;
padding:10px;
text-align:center;
font-weight:bold;
}

.chat-body{
height:300px;
overflow-y:auto;
padding:10px;
}

.input-box{
display:flex;
}

.input-box input{
flex:1;
padding:10px;
border:none;
background:#222;
color:white;
}

.input-box button{
background:#ff00ff;
border:none;
padding:10px;
color:white;
}
</style>
</head>

<body>

<div class="chat-box">

<div class="header">AI Assistant 🤖</div>

<div class="chat-body" id="chat"></div>

<div class="input-box">
<input type="text" id="msg" placeholder="Ask something...">
<button onclick="reply()">Send</button>
</div>

</div>

<script>

function reply(){
let msg = document.getElementById("msg").value.toLowerCase();
let chat = document.getElementById("chat");

chat.innerHTML += "<p><b>You:</b> "+msg+"</p>";

let response = "";

// ✅ SMART RESPONSES
if(msg.includes("hello") || msg.includes("hi")){
response = "Hello 👋 How can I help you?";
}
else if(msg.includes("login")){
response = "Click on login button to access your dashboard.";
}
else if(msg.includes("student")){
response = "Students can view performance, prediction and profile.";
}
else if(msg.includes("teacher")){
response = "Teachers can manage students and view analytics.";
}
else if(msg.includes("prediction")){
response = "AI predicts student performance based on marks and behavior.";
}
else if(msg.includes("contact")){
response = "You can contact us using the contact form on homepage.";
}
else{
response = "Sorry 😅 I don't understand. Try asking about login, student, teacher, prediction.";
}

chat.innerHTML += "<p><b>Bot:</b> "+response+"</p>";

document.getElementById("msg").value="";
chat.scrollTop = chat.scrollHeight;
}

</script>

</body>
</html>