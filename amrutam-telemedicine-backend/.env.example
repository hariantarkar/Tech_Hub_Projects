# Copy this file to .env  (or run: npm run setup:env  -> it fills the secrets for you)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/amrutam
DB_POOL_MAX=20

# Secrets (setup:env makes random values for these two lines)
JWT_SECRET=change_me_to_a_long_random_text_of_32_or_more_chars
# Format: keyId:base64Key,keyId:base64Key   (each key = 32 random bytes in base64)
ENCRYPTION_KEYS=v1:change_me
# The key id used for NEW encryption. Old keys stay in the list so old data can still be read.
ENCRYPTION_ACTIVE_KEY_ID=v1

# Auth rules
ACCESS_TOKEN_MINUTES=30
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
MFA_ISSUER=Amrutam

# Rate limit (per IP)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
# Set to 1 when the app runs behind one proxy / load balancer
TRUST_PROXY=0

# Optional: protect /metrics with a token (Prometheus sends it as a Bearer token)
# METRICS_TOKEN=

# Used only by: npm run seed:admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeThisPassword123
