{
  "name": "amrutam-telemedicine-backend",
  "version": "1.0.0",
  "description": "Telemedicine backend for Amrutam (Node.js + JavaScript + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "setup:env": "node src/scripts/setupEnv.js",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed:admin": "node src/scripts/createAdmin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^12.0.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^5.0.1"
  }
}
